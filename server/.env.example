# Variables del servidor de Voces para probarlo en tu PC (copia a server/.env, ignorado por Git).
# En Render se ponen en el panel (Environment). Valores FICTICIOS.
PORT=10000
# memory = datos en memoria (pruebas); supabase = el proyecto real
VOCES_DATA=memory
# simulated = respuestas de IA ficticias; real = Claude (necesita ANTHROPIC_API_KEY)
VOCES_AI=simulated
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
VOCES_CORS_ORIGINS=http://localhost:5173
