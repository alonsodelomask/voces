# Copia este archivo como .env.local y rellena con los datos de tu proyecto de Supabase
# (Project Settings → API). La "anon key" es pública: está pensada para ir en la app.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Servidor de Voces en Render (IA, borrar la cuenta y revocación de Apple). Ver docs/BACKEND.md.
VITE_API_URL=https://voces-api.onrender.com
