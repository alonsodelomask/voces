{
  "expo": {
    "name": "Vocify",
    "slug": "vocify",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "vocify",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14041a",
    "ios": {
      "bundleIdentifier": "es.vocify.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Partitura",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "org.musicxml.musicxml",
              "org.musicxml.mxl",
              "public.midi-audio",
              "public.xml"
            ]
          },
          {
            "CFBundleTypeName": "Grabación",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.audio"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "org.musicxml.musicxml",
            "UTTypeDescription": "MusicXML",
            "UTTypeConformsTo": [
              "public.xml",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "musicxml"
              ],
              "public.mime-type": [
                "application/vnd.recordare.musicxml+xml"
              ]
            }
          },
          {
            "UTTypeIdentifier": "org.musicxml.mxl",
            "UTTypeDescription": "MusicXML comprimido",
            "UTTypeConformsTo": [
              "public.zip-archive",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "mxl"
              ],
              "public.mime-type": [
                "application/vnd.recordare.musicxml"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "es.vocify.app",
      "adaptiveIcon": {
        "backgroundColor": "#2a0734",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "audio/midi"
            },
            {
              "scheme": "content",
              "mimeType": "audio/x-midi"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.recordare.musicxml+xml"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.recordare.musicxml"
            },
            {
              "scheme": "content",
              "mimeType": "application/xml"
            },
            {
              "scheme": "content",
              "mimeType": "text/xml"
            },
            {
              "scheme": "content",
              "mimeType": "audio/*"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14041a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Vocify usa el micrófono para convertir en notas lo que cantas o tarareas. El audio no se guarda ni sale del teléfono.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      "expo-status-bar",
      "expo-asset"
    ],
    "owner": "alonsodelomas"
  }
}
