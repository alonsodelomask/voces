{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "ONNXRUNTIME_NODE_INSTALL": "skip"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "ONNXRUNTIME_NODE_INSTALL": "skip"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "ONNXRUNTIME_NODE_INSTALL": "skip"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {}
    },
    "production": {
      "ios": {}
    }
  }
}
